<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/bmw_blue"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtHeaderSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/app_subtitle"
                android:textColor="#DCEBFF"
                android:textSize="12sp" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <!-- Runtime Permissions Warning Card (shown when any permission is missing) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPermissions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/status_error_bg"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/status_error"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/permissions_title"
                            android:textColor="@color/status_error"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtMissingPermissions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/permissions_missing_desc"
                            android:textColor="#3C1412"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnGrantPermissions"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/btn_grant_permissions"
                            app:backgroundTint="@color/status_error" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Prominent Start / Stop Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartTest"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:text="@string/btn_start_test"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:cornerRadius="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStopTest"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="0dp"
                        android:layout_height="56dp"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:text="@string/btn_stop"
                        android:textColor="@color/status_error"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/status_error_bg"
                        app:cornerRadius="12dp" />
                </LinearLayout>

                <!-- Phase 4A Screen Mirroring, CarPlay Dock, Crop Sliders & App Launcher Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/bmw_blue"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/card_mirror_title"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="@color/bmw_blue_dark"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/label_video_source"
                            android:textAppearance="?attr/textAppearanceLabelMedium" />

                        <Spinner
                            android:id="@+id/spinnerVideoSource"
                            android:layout_width="match_parent"
                            android:layout_height="44dp" />

                        <!-- Mirror-specific layout, dock side, crop sliders, and 4 dock apps -->
                        <LinearLayout
                            android:id="@+id/layoutMirrorControls"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/label_mirror_layout"
                                android:textAppearance="?attr/textAppearanceLabelMedium" />

                            <Spinner
                                android:id="@+id/spinnerMirrorLayout"
                                android:layout_width="match_parent"
                                android:layout_height="44dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/label_dock_side"
                                android:textAppearance="?attr/textAppearanceLabelMedium" />

                            <Spinner
                                android:id="@+id/spinnerDockSide"
                                android:layout_width="match_parent"
                                android:layout_height="44dp" />

                            <!-- Top Crop Slider -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/label_crop_top"
                                    android:textAppearance="?attr/textAppearanceLabelMedium" />

                                <TextView
                                    android:id="@+id/txtCropTopValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="monospace"
                                    android:textColor="@color/bmw_blue_dark"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <SeekBar
                                android:id="@+id/seekCropTop"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:max="40" />

                            <!-- Bottom Crop Slider -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/label_crop_bottom"
                                    android:textAppearance="?attr/textAppearanceLabelMedium" />

                                <TextView
                                    android:id="@+id/txtCropBottomValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="monospace"
                                    android:textColor="@color/bmw_blue_dark"
                                    android:textSize="13sp"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <SeekBar
                                android:id="@+id/seekCropBottom"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:max="40" />

                            <!-- Live geometry readout + Reset Crop button -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:background="@color/bmw_blue_container"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="6dp">

                                <TextView
                                    android:id="@+id/txtMirrorGeometryPreview"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:textColor="@color/bmw_blue_dark"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnResetCrop"
                                    style="@style/Widget.Material3.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:minWidth="0dp"
                                    android:paddingHorizontal="8dp"
                                    android:text="@string/btn_reset_crop"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <!-- 4 User-Selectable CarPlay Dock App Slots -->
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/label_dock_apps"
                                android:textAppearance="?attr/textAppearanceLabelMedium" />

                            <LinearLayout
                                android:id="@+id/dockSlotsContainer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:orientation="horizontal" />

                            <!-- BMW Touch (AccessibilityService) Status & Quick Shortcuts -->
                            <LinearLayout
                                android:id="@+id/layoutAccessibilityBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:background="@color/status_warning_bg"
                                android:orientation="vertical"
                                android:padding="10dp">

                                <TextView
                                    android:id="@+id/txtAccessibilityStatus"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/status_warning"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/txtAccessibilityTip"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="@string/accessibility_restricted_tip"
                                    android:textColor="@color/status_warning"
                                    android:textSize="11sp" />

                                <LinearLayout
                                    android:id="@+id/layoutAccessibilityButtons"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:orientation="horizontal">

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnEnableAccessibility"
                                        style="@style/Widget.Material3.Button.TonalButton"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_marginEnd="6dp"
                                        android:layout_weight="1"
                                        android:text="@string/btn_enable_accessibility"
                                        android:textSize="12sp" />

                                    <com.google.android.material.button.MaterialButton
                                        android:id="@+id/btnAppInfoRestricted"
                                        style="@style/Widget.Material3.Button.OutlinedButton"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:text="@string/btn_app_info_restricted"
                                        android:textSize="12sp" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchAutoConnect"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/switch_auto_connect" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 7 Live Steps Indicator Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/card_steps_title"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/txtHeadlineStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:layout_marginBottom="8dp"
                            android:textColor="@color/bmw_blue"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:id="@+id/stepsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <!-- Live BMW Wi-Fi Quick Actions (shown once 0x5703 credentials arrive) -->
                        <LinearLayout
                            android:id="@+id/layoutWifiActions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@color/bmw_blue_container"
                            android:orientation="vertical"
                            android:padding="10dp"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/txtWifiCredsBanner"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:textColor="@color/bmw_blue_dark"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnRetryWifi"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:layout_weight="1"
                                    android:text="@string/btn_retry_wifi"
                                    android:textSize="12sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnCopyWifiPass"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/btn_copy_wifi_pass"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnAdoptManualWifi"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="@string/btn_adopt_manual_wifi"
                                android:textColor="@color/bmw_blue_dark"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtPhase2Verdict"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@color/status_success_bg"
                            android:padding="10dp"
                            android:textColor="@color/status_success"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- First CarPlay Pairing Helper Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/card_pairing_title"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineSpacingExtra="3dp"
                            android:text="@string/pairing_instructions"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDiscoverable"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/btn_make_discoverable" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Connection Settings Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/card_settings_title"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textStyle="bold" />

                        <!-- Phone real BT MAC -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/layoutPhoneMac"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:hint="@string/label_phone_bt_mac"
                                app:helperText="@string/helper_phone_bt_mac">

                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/editPhoneMac"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:fontFamily="monospace"
                                    android:inputType="textCapCharacters|textNoSuggestions"
                                    android:maxLength="17"
                                    android:singleLine="true" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnResetS25Mac"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="@string/btn_reset_s25_mac" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtMacBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:background="@color/status_success_bg"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:text="@string/badge_saved"
                            android:textColor="@color/status_success"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <!-- Target BMW Device Selector -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/label_target_car"
                                android:textAppearance="?attr/textAppearanceLabelLarge" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRefreshDevices"
                                style="@style/Widget.Material3.Button.TextButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/btn_refresh_devices" />
                        </LinearLayout>

                        <Spinner
                            android:id="@+id/spinnerTargetCar"
                            android:layout_width="match_parent"
                            android:layout_height="44dp" />

                        <!-- Collapsible Advanced Test Options -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnToggleAdvanced"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:gravity="start|center_vertical"
                            android:text="@string/advanced_options_toggle" />

                        <LinearLayout
                            android:id="@+id/layoutAdvancedOptions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingTop="4dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/label_mfi_length"
                                android:textAppearance="?attr/textAppearanceLabelMedium" />

                            <Spinner
                                android:id="@+id/spinnerMfiLength"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginBottom="8dp" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/label_rfcomm_mode"
                                android:textAppearance="?attr/textAppearanceLabelMedium" />

                            <Spinner
                                android:id="@+id/spinnerRfcommMode"
                                android:layout_width="match_parent"
                                android:layout_height="44dp"
                                android:layout_marginBottom="8dp" />

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switchOutboundClient"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/switch_outbound_client" />

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switchFullHex"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/switch_full_hex" />

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/switchKeepScreenOn"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/switch_keep_screen_on" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnManualWifiTest"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/btn_manual_wifi_test" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Live Diagnostic Log Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:strokeColor="@color/card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/card_log_title"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/txtSessionFile"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:textColor="@color/status_waiting"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:scrollbars="none">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnCopyLog"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:text="@string/btn_copy_log" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnShareLog"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:text="@string/btn_share_log" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnPastSessions"
                                    style="@style/Widget.Material3.Button.OutlinedButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="6dp"
                                    android:text="@string/btn_past_sessions" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnClearLog"
                                    style="@style/Widget.Material3.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/btn_clear_log" />
                            </LinearLayout>
                        </HorizontalScrollView>

                        <ScrollView
                            android:id="@+id/logScrollView"
                            android:layout_width="match_parent"
                            android:layout_height="320dp"
                            android:layout_marginTop="8dp"
                            android:background="@color/log_bg"
                            android:nestedScrollingEnabled="true"
                            android:padding="10dp">

                            <TextView
                                android:id="@+id/txtLiveLog"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="monospace"
                                android:text="@string/log_empty_placeholder"
                                android:textColor="@color/log_text"
                                android:textIsSelectable="true"
                                android:textSize="11sp" />
                        </ScrollView>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
